# Kimi / Moonshot（OpenAI 兼容）
# 国内常用 https://api.moonshot.cn/v1
# 国际常用 https://api.moonshot.ai/v1
MOONSHOT_API_KEY=sk-your-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# 8k 会自动按窗口预算分段；大 diff 可改 moonshot-v1-32k / moonshot-v1-128k
MOONSHOT_MODEL=moonshot-v1-8k

# 可选：被审仓库路径；默认为当前工作目录
# TARGET_REPO=

# 飞书自定义机器人（群 Webhook；签名校验填 SECRET；消息须含 KEYWORD）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# FEISHU_WEBHOOK_SECRET=
# FEISHU_WEBHOOK_KEYWORD=审核推送
# FEISHU_NOTIFY=auto
